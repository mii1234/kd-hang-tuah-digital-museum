{
  "name": "kd-hang-tuah-digital-museum",
  "private": true,
  "version": "1.0.0",
  "description": "KD Hang Tuah Digital Maritime Museum — frontend-only heritage website driven by editable JSON data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate-data": "node scripts/validate-data.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@react-three/fiber": "9.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
